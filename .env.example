# ---------------------------------------------------------------------------
# HonshuWheel environment configuration
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (docker-compose default below)
DATABASE_URL="postgresql://honshu:honshu@localhost:5432/honshuwheel?schema=public"

# Auth.js secret: generate with `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-long-random-secret"
# Public URL of the site (used by Auth.js for callbacks)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# LAUNCH MODE
# While false the site runs in DEMO MODE: free demo credits, no real
# payments, withdrawals or shipping. Enforced on the server.
# Do NOT set to true until every item in the README pre-launch checklist is done.
# ---------------------------------------------------------------------------
REAL_MONEY_ENABLED="false"

# Bootstrap admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@honshuwheel.local"
ADMIN_PASSWORD="change-me-admin-password"

# ---------------------------------------------------------------------------
# Pluggable providers. Each has a safe local default.
# ---------------------------------------------------------------------------
# Payments: "test" (fake provider; the only one shipped)
PAYMENT_PROVIDER="test"
# Identity verification: "mock" (auto-approves after a short delay)
IDENTITY_PROVIDER="mock"
# IP geolocation: "mock" | "header" (Vercel/Cloudflare region header) | "maxmind"
GEO_PROVIDER="mock"
MAXMIND_ACCOUNT_ID=""
MAXMIND_LICENSE_KEY=""
# File storage for product photos: "local" | "s3" (S3-compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
# Email: "console" (logs to stdout) | "resend"
MAIL_PROVIDER="console"
RESEND_API_KEY=""
MAIL_FROM="HonshuWheel <no-reply@example.com>"

# Secret for cron-style jobs (vault expiry). Call /api/jobs/vault-expiry with
# header `Authorization: Bearer <JOBS_SECRET>`.
JOBS_SECRET="replace-me-with-a-random-secret"
