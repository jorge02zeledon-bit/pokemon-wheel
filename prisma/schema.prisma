// ---------------------------------------------------------------------------
// HonshuWheel database schema
//
// Conventions
//  - All money is stored as integer CENTS (never floats).
//  - All odds are stored as integer BASIS POINTS (10,000 bps = 100%).
//  - `isDemo` marks activity performed with demo credits. Demo balances never
//    convert to real money.
//  - Spin and LedgerEntry rows are append-only. A database trigger (see the
//    init migration) rejects UPDATE/DELETE so the audit trail cannot be edited.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Enums ---------------------------------------

enum Role {
  USER
  ADMIN
}

/// Display grouping for tiers. Admin may add any number of tiers per wheel;
/// rarity drives colours and the "confetti" threshold (RARE and CHASE).
enum Rarity {
  COMMON
  UNCOMMON
  RARE
  CHASE
}

enum ProductCategory {
  BOOSTER_PACK
  BLISTER
  TIN
  COLLECTION_BOX
  ELITE_TRAINER_BOX
  BOOSTER_BUNDLE
  PREMIUM_COLLECTION
  BOOSTER_BOX
  JAPANESE_BOX
  OTHER
}

enum VaultStatus {
  PENDING // waiting for the user to decide (ship or sell)
  SOLD // sold back for buyback credit
  SHIP_REQUESTED // user asked for shipping; an Order exists
  SHIPPED // order fulfilled
  HELD // window expired with "auto-ship-hold": awaiting address, no expiry
}

enum OrderStatus {
  REQUESTED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum LedgerType {
  DEMO_GRANT
  SPIN
  BUYBACK
  DEPOSIT
  WITHDRAWAL
  SHIPPING_FEE
  ADJUSTMENT
  REFUND
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum ExclusionDuration {
  DAYS_30
  MONTHS_6
  PERMANENT
}

// ----------------------------- Users ---------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  displayName  String?
  role         Role    @default(USER)

  /// Set when the user confirmed they are 18+ at signup.
  ageConfirmedAt DateTime?
  /// Two-letter US state the user stated at signup (checked against BlockedState).
  stateCode      String?   @db.VarChar(2)

  /// Latest identity verification outcome (history lives in IdentityVerification).
  identityStatus VerificationStatus @default(NOT_STARTED)

  /// Balances in cents. Demo credits never convert to real money.
  demoBalanceCents Int       @default(0)
  realBalanceCents Int       @default(0)
  lastDemoRefillAt DateTime?

  // --- Provably fair state -------------------------------------------------
  /// Client seed the user can change at any time from their account page.
  clientSeed         String
  /// Incrementing per-user counter included in every spin hash.
  nonce              Int    @default(0)
  /// The server seed that will be used for the NEXT spin. Only its hash is
  /// shown to the user before spinning; the seed itself is revealed afterwards.
  nextServerSeed     String
  nextServerSeedHash String

  // --- Responsible play ----------------------------------------------------
  /// "Take a break" cooldown: spins are blocked until this time.
  cooldownUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spins          Spin[]
  vaultItems     VaultItem[]
  orders         Order[]
  ledgerEntries  LedgerEntry[]
  deposits       Deposit[]
  withdrawals    Withdrawal[]
  verifications  IdentityVerification[]
  playLimit      PlayLimit?
  selfExclusions SelfExclusion[]
  adminActions   AdminAuditLog[]        @relation("AdminActions")
}

// ----------------------------- Wheels --------------------------------------

model Wheel {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String?
  description String?

  /// Price of one spin in cents.
  spinPriceCents Int
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)

  /// Optional rule: the lowest-value prize must be worth at least the spin price.
  /// Admin shows a warning when a wheel violates it.
  guaranteedFloor Boolean @default(false)

  /// Hex colour used for the wheel's accent in the UI.
  accentColor String @default("#22d3ee")

  tiers Tier[]
  spins Spin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tier {
  id      String @id @default(cuid())
  wheelId String
  wheel   Wheel  @relation(fields: [wheelId], references: [id], onDelete: Cascade)

  name      String
  rarity    Rarity
  /// Probability in basis points. All tiers of a wheel must sum to 10,000.
  oddsBps   Int
  sortOrder Int    @default(0)
  /// Hex colour for this tier's wheel segments.
  color     String @default("#64748b")

  products TierProduct[]
  spins    Spin[]

  @@index([wheelId])
}

/// A sealed product that can be awarded. Products are global: the same product
/// (e.g. a 151 ETB) may appear in several wheels and shares one stock count.
model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  category    ProductCategory
  /// Listed market value in cents. Drives EV, RTP and buyback price.
  valueCents  Int
  /// Units on hand and not yet awarded. Decremented atomically on a win.
  stock       Int             @default(0)
  /// URL of an admin-uploaded photo. Null shows the placeholder image.
  imageUrl    String?
  description String?
  isActive    Boolean         @default(true)

  tiers      TierProduct[]
  spins      Spin[]
  vaultItems VaultItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Many-to-many link between tiers and products.
model TierProduct {
  tierId    String
  productId String
  tier      Tier    @relation(fields: [tierId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([tierId, productId])
  @@index([productId])
}

// ----------------------------- Spins (audit log) ---------------------------

/// Immutable record of every spin. Protected by a DB trigger against
/// UPDATE and DELETE. Holds everything needed to independently verify the
/// outcome: seeds, nonce, resulting hash and a snapshot of the odds in force.
model Spin {
  id String @id @default(cuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  wheelId   String
  wheel     Wheel   @relation(fields: [wheelId], references: [id])
  tierId    String
  tier      Tier    @relation(fields: [tierId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  spinPriceCents    Int
  productValueCents Int
  isDemo            Boolean

  // Provably fair data
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int
  /// Hex HMAC-SHA256(serverSeed, `${clientSeed}:${nonce}`)
  resultHash     String
  /// Tier roll derived from the hash, in [0, 10000).
  tierRoll       Int
  /// Index of the product chosen within the tier's product list.
  productRoll    Int
  /// Snapshot of tiers/odds/products at spin time so past spins stay verifiable
  /// after the admin edits a wheel.
  oddsSnapshot   Json

  /// Client-visible metadata (IP-derived state, user agent) for compliance review.
  ipState   String?  @db.VarChar(2)
  createdAt DateTime @default(now())

  vaultItem VaultItem?

  @@index([userId, createdAt])
  @@index([wheelId, createdAt])
  @@index([createdAt])
}

// ----------------------------- Vault, orders -------------------------------

model VaultItem {
  id String @id @default(cuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  spinId    String  @unique
  spin      Spin    @relation(fields: [spinId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Product value at the time of the win (buyback is a % of this).
  valueCents   Int
  isDemo       Boolean
  status       VaultStatus @default(PENDING)
  /// Deadline for the user to choose ship or sell; null once decided or HELD.
  expiresAt    DateTime?
  /// Buyback amount credited when sold.
  buybackCents Int?
  decidedAt    DateTime?
  /// True when the decision was applied automatically after the window closed.
  autoDecided  Boolean     @default(false)

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
}

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status           OrderStatus @default(REQUESTED)
  shippingFeeCents Int

  recipientName String
  line1         String
  line2         String?
  city          String
  state         String  @db.VarChar(2)
  postalCode    String
  country       String  @default("US")

  carrier        String?
  trackingNumber String?
  adminNotes     String?

  vaultItem VaultItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ----------------------------- Wallet --------------------------------------

/// Append-only ledger. Balance changes are always written here alongside the
/// User balance update, inside the same transaction.
model LedgerEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type              LedgerType
  /// Signed amount in cents (negative = debit).
  amountCents       Int
  /// Balance (demo or real, per isDemo) after this entry was applied.
  balanceAfterCents Int
  isDemo            Boolean

  /// Optional pointer to the related record (spin id, vault item id, deposit id...).
  referenceType String?
  referenceId   String?
  description   String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Deposit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  provider    String
  providerRef String?
  amountCents Int
  status      PaymentStatus @default(PENDING)
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model Withdrawal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  provider    String
  providerRef String?
  amountCents Int
  status      PaymentStatus @default(PENDING)
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// ----------------------------- Compliance ----------------------------------

model IdentityVerification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  provider    String
  providerRef String?
  status      VerificationStatus @default(PENDING)
  reason      String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

/// User-set responsible play limits. Decreases apply immediately; increases
/// are stored as pending and apply after a cooling-off period.
model PlayLimit {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  dailyDepositCents   Int?
  weeklyDepositCents  Int?
  monthlyDepositCents Int?
  dailySpendCents     Int?

  /// Pending increases: { field: cents } applied at pendingEffectiveAt.
  pendingChanges     Json?
  pendingEffectiveAt DateTime?

  updatedAt DateTime @updatedAt
}

/// Self-exclusion periods. Cannot be shortened or removed by the user.
model SelfExclusion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  duration ExclusionDuration
  startsAt DateTime          @default(now())
  /// Null for PERMANENT.
  endsAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId, endsAt])
}

/// US states where spinning is not allowed. Editable in admin.
model BlockedState {
  code      String   @id @db.VarChar(2)
  name      String
  note      String?
  createdAt DateTime @default(now())
}

// ----------------------------- Settings & admin audit ----------------------

/// Global key/value settings (RTP range, buyback %, vault window, fees...).
/// Typed access with defaults lives in src/server/settings.ts.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Who changed what in the admin panel.
model AdminAuditLog {
  id      String @id @default(cuid())
  adminId String
  admin   User   @relation("AdminActions", fields: [adminId], references: [id])

  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?

  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}
